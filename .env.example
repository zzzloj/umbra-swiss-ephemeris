# Copy to .env only on the deployment host. Never commit .env.
#
# AGPL_SOURCE_URL must be a durable PUBLIC URL for this repository's complete
# corresponding source before a service is reachable by anyone outside the
# trusted deployment network. Prefer an immutable tag or commit URL.
SWISS_EPHEMERIS_LICENSE_MODE=agpl
# Replace the commit below whenever the deployed image changes. The source URL
# must resolve to the exact public commit corresponding to that image.
AGPL_SOURCE_URL=https://github.com/zzzloj/umbra-swiss-ephemeris/tree/2f040371f6fa4d39ccb1ecece25768339be81f30

# Generate and keep this only in the deployment secret manager / .env.
SWISS_EPHEMERIS_SERVICE_KEY=replace-with-a-long-random-secret

# Absolute host path. This directory is mounted read-only and is deliberately
# not copied into the source repository or container image.
SWE_EPHEMERIS_DATA_DIR=/absolute/path/to/authorised-swiss-ephemeris-data

# Compose binds only to loopback. A product backend should use a private
# network endpoint in production instead of exposing this port publicly.
SWISS_EPHEMERIS_PORT=8080
